pkgname=cadence
pkgver=0.1.0
pkgrel=1
pkgdesc='Track composition sessions and ideas between teaching days'
arch=('x86_64' 'aarch64')
url=''
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-utils')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/cadence "$pkgdir/usr/bin/cadence"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/cadence.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/cadence.svg"
  install -Dm644 "$startdir/cadence.desktop" "$pkgdir/usr/share/applications/cadence.desktop"
}
